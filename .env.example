# Application Configuration
APP_NAME="Enterprise RAG AI Assistant"
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production-min-32-chars

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enterprise_rag_db
POSTGRES_ASYNC_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_rag_db
POSTGRES_SYNC_URI=postgresql+psycopg2://postgres:postgres@localhost:5432/enterprise_rag_db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# AI Provider Configuration (Placeholders for upcoming phases)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
LLM_MODEL=gpt-4o-mini
